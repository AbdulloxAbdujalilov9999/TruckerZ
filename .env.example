# Postgres connection string. WHICH POOLER YOU WANT DEPENDS ON WHERE THIS RUNS:
#
# - Local dev / a VPS (one persistent Node process): use the SESSION pooler,
#   port 5432. It behaves like a normal connection — supports migrations,
#   advisory locks, everything.
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
#
# - Vercel or any other serverless host (many short-lived function
#   instances, each opening its own connection): use the TRANSACTION
#   pooler, port 6543. The session pooler's connection limit is sized for
#   one persistent server and gets exhausted fast under serverless
#   concurrency — this is the actual cause if a deployed page works
#   sometimes and 500s under load. Verified this works fine for normal
#   app queries (including several run concurrently); it only struggles
#   with Prisma's *migration* engine specifically, so still run
#   `prisma migrate deploy` from a session-pooler connection, not this one.
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
#
# Find both in Supabase: Project Settings -> Database -> Connect.
# `uselibpqcompat=true` avoids pg v8.23+ forcing full chain verification on
# sslmode=require, which Supabase's pooler cert chain fails by default.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Supabase Storage (document uploads). From Project Settings -> API.
# SUPABASE_SECRET_KEY must be the *secret* key (server-only, bypasses RLS) —
# never the publishable/anon key, and never expose it to the browser.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="replace-me"
SUPABASE_STORAGE_BUCKET="truckerz-uploads"
